BOT_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Опционально — без него голосовые сообщения не распознаются
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Telegram ID владельца — единственный, кто видит админ-команды фабрики (/admin и т.п.)
OWNER_ID=your_telegram_user_id_here

# Ключ шифрования токенов ботов в БД (Fernet, cryptography). Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# Опционально — путь к JSON-ключу общего Service Account для фичи sheets
# (features/sheets.py). Один аккаунт на всю фабрику, не per-bot. Без него
# фича "sheets" недоступна ни одному боту.
# GOOGLE_SHEETS_SA_KEY_PATH=/absolute/path/to/service-account-key.json

# Альтернатива GOOGLE_SHEETS_SA_KEY_PATH — base64 от того же JSON-ключа,
# декодируется в памяти при старте, на диск не пишется. Полезно там, где
# вставка сырого JSON через веб-консоль ненадёжна (например Railway Console),
# а Variables — надёжны. Если задана — имеет приоритет над _PATH.
# GOOGLE_SHEETS_SA_KEY_B64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsIC4uLn0=

# Путь к персистентным данным (БД, сгенерированные боты, картинки).
# По умолчанию (если не задать) — папка data/ рядом с самим проектом,
# независимо от рабочей директории процесса. На VDS диск персистентный
# по умолчанию — трогать не нужно. Раскомментируй и укажи свой путь только
# если нужно вынести данные за пределы репозитория.
# DATA_DIR=/absolute/path/to/data

# ── channel_monitor (userbot/Telethon) — см. docs/USERBOT_CHANNEL_MONITOR_DESIGN.md ──

# Отдельный ключ шифрования для userbot-сессий (Telethon StringSession) —
# НЕ переиспользует ENCRYPTION_KEY выше, ротация одного не требует ротации
# другого. Обязателен для templates/channel_monitor.py и
# runtime/userbot_worker.py. Сгенерировать так же, как ENCRYPTION_KEY:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USERBOT_ENCRYPTION_KEY=your_fernet_key_here

# Telegram Client API credentials — получить на https://my.telegram.org/apps.
# Обязательны для авторизации userbot-клиента (без них FSM в
# templates/channel_monitor.py откажет с понятной ошибкой).
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Ключ Gemini API для суммаризации постов (services/gemini_service.py).
# Опционально — без него summarize_post() деградирует до None, лента
# показывает сырой текст поста вместо summary.
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Cloudpayments (альтернатива ЮKassa) — см. runtime/cloudpayments_api.py ──
# public_id/api_secret сами вводятся владельцем каждого бота отдельно через
# PaymentConnectFlow (handlers/manage_bots.py) и хранятся per-bot в
# bot_payment_providers — HMAC-подпись вебхука тоже проверяется per-bot тем
# же api_secret, отдельного глобального ключа для Cloudpayments не требуется.
